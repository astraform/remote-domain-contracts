{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraform.ai/schema/remote-domain/v1/remote-domain.schema.json",
  "title": "Remote Domain Protocol v1 Schemas",
  "description": "JSON Schema bundle for the remote-domain.v1 wire contract.",
  "$defs": {
    "nativeSimulationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "providerRevision",
        "mutationMode",
        "stateScope",
        "workKinds",
        "maxWindowWorkItems",
        "initialBoundaryMode"
      ],
      "properties": {
        "profile": {
          "const": "remote-domain.native-state-transform.v1"
        },
        "providerRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mutationMode": {
          "const": "PURE_STATE_TRANSFORM"
        },
        "stateScope": {
          "const": "AGENT"
        },
        "workKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "maxWindowWorkItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "initialBoundaryMode": {
          "const": "PREPARE_INCLUDES_START"
        }
      }
    },
    "nativeReferenceSimulationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "providerRevision",
        "mutationMode",
        "stateScope",
        "workKinds",
        "maxWindowWorkItems",
        "initialBoundaryMode"
      ],
      "properties": {
        "profile": {
          "const": "remote-domain.native-reference-state.v1"
        },
        "providerRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mutationMode": {
          "const": "TRANSACTIONAL_REFERENCE_STATE"
        },
        "stateScope": {
          "const": "AGENT"
        },
        "workKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32
        },
        "maxWindowWorkItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "initialBoundaryMode": {
          "const": "ATTACH_PREPOPULATED_STATE"
        }
      }
    },
    "genericObject": {
      "type": "object",
      "additionalProperties": true
    },
    "noPromptLikeFields": {
      "if": { "type": "object" },
      "then": {
        "propertyNames": {
          "not": {
            "enum": ["prompt", "systemPrompt", "rawProviderText", "chainOfThought"]
          }
        },
        "additionalProperties": { "$ref": "#/$defs/noPromptLikeFields" }
      },
      "else": {
        "if": { "type": "array" },
        "then": {
          "items": { "$ref": "#/$defs/noPromptLikeFields" }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "$ref": "#/$defs/genericObject" }
      }
    },
    "operationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string" },
        "timeoutMs": { "type": "integer" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "domain", "transport", "operations", "capabilities"],
      "properties": {
        "protocolVersion": { "const": "remote-domain.v1" },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domainId", "displayName"],
          "properties": {
            "domainId": { "type": "string" },
            "displayName": { "type": "string" },
            "description": { "type": "string" },
            "schemaVersion": { "type": "string" }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "contentType"],
          "properties": {
            "mode": { "const": "SYNCHRONOUS_HTTP_JSON" },
            "contentType": { "type": "string", "minLength": 1 }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prepare", "executeWork", "status", "inspection"],
          "properties": {
            "prepare": { "$ref": "#/$defs/operationDescriptor" },
            "executeWork": { "$ref": "#/$defs/operationDescriptor" },
            "domainSystemWorkWindow": { "$ref": "#/$defs/operationDescriptor" },
            "controlAction": { "$ref": "#/$defs/operationDescriptor" },
            "status": { "$ref": "#/$defs/operationDescriptor" },
            "inspection": { "$ref": "#/$defs/operationDescriptor" },
            "shutdown": { "$ref": "#/$defs/operationDescriptor" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusProjection",
            "inspectionProjection",
            "maxOpaqueStateBytes",
            "supportedAgentTypes",
            "supportedInteractionModes"
          ],
          "properties": {
            "statusProjection": { "type": "boolean" },
            "inspectionProjection": { "type": "boolean" },
            "shutdownNotification": { "type": "boolean" },
            "maxOpaqueStateBytes": { "type": "integer" },
            "supportedAgentTypes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "supportedInteractionModes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "remoteProviderLanguage": { "type": "string" },
            "nativeSimulation": { "oneOf": [{ "$ref": "#/$defs/nativeSimulationProfile" }, { "$ref": "#/$defs/nativeReferenceSimulationProfile" }] },
            "supportsInitialAccounts": { "type": "boolean" },
            "supportsScheduledWork": { "type": "boolean" },
            "scheduledWorkKinds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "label"],
                "properties": {
                  "kind": { "type": "string" },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "fields": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/genericObject" }
                  }
                }
              }
            },
            "supportsDomainSystemWorkWindow": { "type": "boolean" },
            "domainSystemWorkKinds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "label"],
                "properties": {
                  "kind": { "type": "string" },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "fields": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/genericObject" }
                  }
                }
              }
            },
            "supportsControlActions": { "type": "boolean" },
            "controlActions": {
              "type": "array",
              "items": { "$ref": "#/$defs/controlActionDescriptor" }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "inputSchema": { "$ref": "#/$defs/genericObject" },
                  "outputSchema": { "$ref": "#/$defs/genericObject" },
                  "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "effectClass": { "const": "READ_ONLY" },
                  "scope": { "const": "CUSTOMER_CONTEXT" }
                }
              }
            }
          }
        },
        "uiProfile": {
          "$ref": "#/$defs/genericObject"
        }
      }
    },
    "controlActionDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "label", "category", "inputSchema"],
      "properties": {
        "actionId": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "category": { "enum": ["BROADCAST", "POLICY_CHANGE", "MARKET_EVENT", "INCIDENT", "CAPACITY", "CUSTOM"] },
        "supportedModes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targetScopes": {
          "type": "array",
          "items": { "enum": ["AGENT", "SEGMENT", "COHORT", "RUN", "BROADCAST"] }
        },
        "inputSchema": { "$ref": "#/$defs/genericObject" },
        "uiSchema": { "$ref": "#/$defs/genericObject" },
        "requiredCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sideEffectLevel": { "enum": ["NONE", "LOW", "MEDIUM", "HIGH"] },
        "evidenceRequirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "instanceId", "platformVersion"],
      "properties": {
        "service": { "type": "string" },
        "instanceId": { "type": "string" },
        "platformVersion": { "type": "string" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainId"],
      "properties": {
        "domainId": { "type": "string" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "personaName"],
      "properties": {
        "agentId": { "type": "string" },
        "conversationId": { "type": "string" },
        "runtimeIdentity": { "type": "string" },
        "personaName": { "type": "string" },
        "agentType": { "type": "string" },
        "personaDescription": { "type": "string" },
        "traits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interactionMode": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "simulationStartEpochMs": { "type": "integer" },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rate": { "type": "number" },
            "paused": { "type": "boolean" }
          }
        },
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "resetStateOnClockRewind": { "type": "boolean" },
            "strictClock": { "type": "boolean" }
          }
        },
        "contractVersion": { "type": "integer" },
        "updatedAtEpochMs": { "type": "integer" }
      }
    },
    "opaqueState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "data"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "data": { "$ref": "#/$defs/genericObject" }
      }
    },
    "dueWorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "workType", "occurrenceKey", "scheduledForEpochMs", "attemptNumber"],
      "properties": {
        "workId": {
          "type": "string",
          "description": "Stable business-command identity across worker attempts for the same effect."
        },
        "workType": { "type": "string" },
        "occurrenceKey": { "type": "string" },
        "scheduledForEpochMs": { "type": "integer" },
        "attemptNumber": { "type": "integer" },
        "description": { "type": "string" },
        "payload": { "$ref": "#/$defs/genericObject" }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousTimeEpochMs", "currentTimeEpochMs"],
      "properties": {
        "previousTimeEpochMs": { "type": "integer" },
        "currentTimeEpochMs": { "type": "integer" }
      }
    },
    "turnContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeWindow", "dueWork"],
      "properties": {
        "timeWindow": { "$ref": "#/$defs/timeWindow" },
        "dueWork": {
          "type": "array",
          "items": { "$ref": "#/$defs/dueWorkItem" }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeMetadata": { "$ref": "#/$defs/genericObject" },
        "lifecycleSchedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "inspectionSchedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "statusView": { "$ref": "#/$defs/genericObject" },
        "inspectionView": { "$ref": "#/$defs/genericObject" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "properties": {
        "runtimeIdentity": { "type": "string" },
        "toolResult": { "$ref": "#/$defs/genericObject" },
        "projection": { "$ref": "#/$defs/projection" },
        "domainSystemWork": { "$ref": "#/$defs/genericObject" },
        "controlAction": { "$ref": "#/$defs/genericObject" },
        "evidenceEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        }
      }
    },
    "customerDecisionTriggerPayload": {
      "description": "Sanitized domain-fact payload only. Prompt-like fields such as prompt, systemPrompt, rawProviderText, and chainOfThought are not allowed at any nesting level.",
      "allOf": [
        { "$ref": "#/$defs/noPromptLikeFields" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "customerDecisionTrigger": {
      "description": "Domain-fact trigger that can create a customer decision opportunity. This is not a prompt and must not contain prompt, provider output, or chain-of-thought fields at any nesting level.",
      "allOf": [
        { "$ref": "#/$defs/noPromptLikeFields" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "schemaVersion",
            "triggerId",
            "triggerType",
            "triggerRef",
            "scheduledForEpochMs",
            "priority",
            "reason",
            "payload"
          ],
          "properties": {
            "schemaVersion": { "const": "customer_decision_trigger.v1" },
            "triggerId": { "type": "string", "minLength": 1 },
            "triggerType": { "type": "string", "minLength": 1 },
            "triggerRef": { "type": "string", "minLength": 1 },
            "scheduledForEpochMs": { "type": "integer" },
            "priority": {
              "type": "string",
              "minLength": 1,
              "description": "Deprecated v1 priority hint retained for wire compatibility. It does not create domain-defined queue ranks. New providers should publish schedulingPriority and keep domain severity in payload."
            },
            "schedulingPriority": {
              "enum": ["CRITICAL", "HIGH", "NORMAL", "LOW"],
              "description": "Optional core-owned scheduling priority. Missing or unrecognized legacy priority hints resolve to NORMAL. The legacy priority value URGENT normalizes to CRITICAL, but is not valid in this field."
            },
            "reason": { "type": "string", "minLength": 1 },
            "payload": { "$ref": "#/$defs/customerDecisionTriggerPayload" },
            "agentId": { "type": "string", "minLength": 1 },
            "evidenceRefs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "domainSystemWorkWindowResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["windowStartEpochMs", "windowEndEpochMs", "evaluatedWorkCount", "executedWorkCount"],
      "properties": {
        "windowStartEpochMs": { "type": "integer" },
        "windowEndEpochMs": { "type": "integer" },
        "evaluatedWorkCount": { "type": "integer" },
        "executedWorkCount": { "type": "integer" },
        "workResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "stateDeltas": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "checkpointRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "nextDueHints": {
          "type": "array",
          "items": { "$ref": "#/$defs/genericObject" }
        },
        "decisionTriggers": {
          "type": "array",
          "description": "Optional domain-fact triggers that can create customer decision opportunities. These are not prompts and must not contain prompt, provider output, or chain-of-thought fields at any nesting level.",
          "items": { "$ref": "#/$defs/customerDecisionTrigger" }
        }
      }
    },
    "mutatingEnvelope": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "operation",
        "idempotencyKey",
        "sentAtEpochMs",
        "deadlineEpochMs",
        "host",
        "domain",
        "agent"
      ],
      "properties": {
        "protocolVersion": { "const": "remote-domain.v1" },
        "requestId": { "type": "string", "format": "uuid" },
        "operation": { "type": "string" },
        "idempotencyKey": {
          "type": "string",
          "description": "Transport identity for one immutable mutating request; changed request bodies use a new key."
        },
        "sentAtEpochMs": { "type": "integer" },
        "deadlineEpochMs": { "type": "integer" },
        "host": { "$ref": "#/$defs/host" },
        "domain": { "$ref": "#/$defs/domain" },
        "agent": { "$ref": "#/$defs/agent" },
        "replay": { "$ref": "#/$defs/replay" },
        "state": { "$ref": "#/$defs/opaqueState" }
      }
    },
    "projectionEnvelope": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "operation",
        "sentAtEpochMs",
        "deadlineEpochMs",
        "host",
        "domain",
        "agent",
        "state"
      ],
      "properties": {
        "protocolVersion": { "const": "remote-domain.v1" },
        "requestId": { "type": "string", "format": "uuid" },
        "operation": { "type": "string" },
        "sentAtEpochMs": { "type": "integer" },
        "deadlineEpochMs": { "type": "integer" },
        "host": { "$ref": "#/$defs/host" },
        "domain": { "$ref": "#/$defs/domain" },
        "agent": { "$ref": "#/$defs/agent" },
        "replay": { "$ref": "#/$defs/replay" },
        "state": { "$ref": "#/$defs/opaqueState" }
      }
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation", "result", "nextState", "warnings"],
      "properties": {
        "protocolVersion": { "const": "remote-domain.v1" },
        "requestId": { "type": "string", "format": "uuid" },
        "operation": { "type": "string" },
        "result": { "$ref": "#/$defs/result" },
        "nextState": { "$ref": "#/$defs/opaqueState" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "projectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation", "result", "warnings"],
      "properties": {
        "protocolVersion": { "const": "remote-domain.v1" },
        "requestId": { "type": "string", "format": "uuid" },
        "operation": { "type": "string" },
        "result": { "$ref": "#/$defs/result" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "prepareRequest": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/mutatingEnvelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "operation": { "const": "prepare" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["personaConfiguration"],
              "properties": {
                "personaConfiguration": { "$ref": "#/$defs/genericObject" },
                "initialProjectionHints": { "$ref": "#/$defs/genericObject" }
              }
            }
          }
        }
      ]
    },
    "prepareResponse": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/successEnvelope" },
        {
          "type": "object",
          "properties": {
            "operation": { "const": "prepare" }
          }
        }
      ]
    },
    "executeWorkRequest": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/mutatingEnvelope" },
        {
          "type": "object",
          "required": ["state", "payload"],
          "properties": {
            "operation": { "const": "execute-work" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["turnContext"],
              "properties": {
                "turnContext": { "$ref": "#/$defs/turnContext" }
              }
            }
          }
        }
      ]
    },
    "executeWorkResponse": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/successEnvelope" },
        {
          "type": "object",
          "properties": {
            "operation": { "const": "execute-work" }
          }
        }
      ]
    },
    "domainSystemWorkWindowRequest": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/mutatingEnvelope" },
        {
          "type": "object",
          "required": ["state", "payload"],
          "properties": {
            "operation": { "const": "domain-system-work-window" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["timeWindow"],
              "properties": {
                "timeWindow": { "$ref": "#/$defs/timeWindow" },
                "workKinds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "maxWorkItems": { "type": "integer", "minimum": 1 },
                "executionMode": { "enum": ["EVALUATE_AND_EXECUTE", "EVALUATE_ONLY"] },
                "context": { "$ref": "#/$defs/genericObject" }
              }
            }
          }
        }
      ]
    },
    "domainSystemWorkWindowResponse": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/successEnvelope" },
        {
          "type": "object",
          "properties": {
            "operation": { "const": "domain-system-work-window" },
            "result": {
              "type": "object",
              "properties": {
                "domainSystemWork": { "$ref": "#/$defs/domainSystemWorkWindowResult" }
              }
            }
          }
        }
      ]
    },
    "controlActionRequest": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/mutatingEnvelope" },
        {
          "type": "object",
          "required": ["state", "payload"],
          "properties": {
            "operation": { "const": "control-action" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionId", "operationId", "target", "inputs"],
              "properties": {
                "actionId": { "type": "string" },
                "operationId": { "type": "string" },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scope"],
                  "properties": {
                    "scope": { "enum": ["AGENT", "SEGMENT", "COHORT", "RUN", "BROADCAST"] },
                    "agentIds": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "segmentIds": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "cohortId": { "type": "string" },
                    "selector": { "$ref": "#/$defs/genericObject" }
                  }
                },
                "inputs": { "$ref": "#/$defs/genericObject" },
                "requestedBy": { "type": "string" },
                "reason": { "type": "string" },
